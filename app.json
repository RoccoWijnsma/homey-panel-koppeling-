            "nl": "Vermogenspiek gestart"
          },
          "insightsTitleFalse": {
            "en": "Power peak ended",
            "nl": "Vermogenspiek beëindigd"
          }
        }
      },
      "images": {
        "small": "/drivers/energy-insights/assets/images/small.png",
        "large": "/drivers/energy-insights/assets/images/large.png",
        "xlarge": "/drivers/energy-insights/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "energy-insights"
    }
  ],
  "widgets": {
    "energy-timeline": {
      "name": {
        "en": "Energy Timeline",
        "nl": "Energie-tijdlijn"
      },
      "height": 240,
      "settings": [
        {
          "id": "range",
          "type": "dropdown",
          "title": {
            "en": "Time range",
            "nl": "Tijdsbereik"
          },
          "value": "3600000",
          "values": [
            {
              "id": "900000",
              "title": {
                "en": "15 minutes",
                "nl": "15 minuten"
              }
            },
            {
              "id": "3600000",
              "title": {
                "en": "1 hour",
                "nl": "1 uur"
              }
            },
            {
              "id": "21600000",
              "title": {
                "en": "6 hours",
                "nl": "6 uur"
              }
            },
            {
              "id": "86400000",
              "title": {
                "en": "24 hours",
                "nl": "24 uur"
              }
            }
          ]
        },
        {
          "id": "showMarkers",
          "type": "checkbox",
          "title": {
            "en": "Show event markers",
            "nl": "Toon markeringen"
          },
          "value": true
        },
        {
          "id": "showNet",
          "type": "checkbox",
          "title": {
            "en": "Show net grid power",
            "nl": "Toon netto netvermogen"
          },
          "value": true
        }
      ],
      "api": {
        "getTimeline": {
          "method": "GET",
          "path": "/timeline"
        }
      },
      "id": "energy-timeline"
    }
  },
  "capabilities": {
    "energy_peak_reason": {
      "type": "string",
      "title": {
        "en": "Last peak reason",
        "nl": "Oorzaak laatste piek"
      },
      "desc": {
        "en": "Human readable explanation of the most recent power peak.",
        "nl": "Leesbare uitleg van de meest recente vermogenspiek."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": false,
      "icon": "/assets/capabilities/energy_peak_reason.svg"
    },
    "energy_self_sufficiency": {
      "type": "number",
      "title": {
        "en": "Self-sufficiency",
        "nl": "Zelfvoorziening"
      },
      "desc": {
        "en": "Share of the current power usage that is covered by solar production.",
        "nl": "Deel van het huidige verbruik dat door zonneproductie wordt gedekt."
      },
      "units": {
        "en": "%",
        "nl": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "insightsTitle": {
        "en": "Self-sufficiency",
        "nl": "Zelfvoorziening"
      },
      "icon": "/assets/capabilities/energy_self_sufficiency.svg"
    }
  }
}