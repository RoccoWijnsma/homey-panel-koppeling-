{
  "name": "com.homey.energyinsights",
  "version": "1.0.0",
  "description": "Real-time energy visualisation dashboard for Homey with annotated power timelines.",
  "main": "app.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "homey app run",
