    "assets": "node tools/preview/assets.js && node tools/preview/widget.js"
  },
  "dependencies": {
    "homey-api": "^3.9.0"
  },
  "devDependencies": {
    "homey": "^4.5.0",
    "playwright-core": "^1.63.0"
  }
}
